export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_DEFAULT_REGION=us-east-1
export CHECKS=CKV_AWS_41,CKV_AWS_286,CKV_AWS_287,CKV_AWS_288,CKV_AWS_289,CKV_AWS_290,CKV_AWS_355,CKV_AWS_53,CKV_AWS_54,CKV_AWS_55,CKV_AWS_56
awsl() { aws --endpoint-url=http://localhost:4566 "$@"; }
vault_exec() { kubectl -n vault exec -i vault-0 -- env VAULT_TOKEN=root VAULT_ADDR=http://127.0.0.1:8200 vault "$@"; }
